{
  "name": "appstock-geo",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme web universelle CAO + SIG : DWG, DXF, SHP, GeoJSON, KML... dans le navigateur, sans serveur.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "plugin:dwg": "node scripts/install-dwg-plugin.mjs",
    "samples": "node scripts/make-samples.mjs",
    "postinstall": "node scripts/install-dwg-plugin.mjs"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.9.0",
    "@tmcw/togeojson": "^7.1.3",
    "delaunator": "^5.1.0",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "flatbush": "^4.7.0",
    "proj4": "^2.23.0",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/proj4": "^2.5.6",
    "jspdf": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
